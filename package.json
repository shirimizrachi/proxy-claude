{
  "name": "proxy-claude",
  "version": "1.7.0",
  "description": "Use Claude Code CLI with your GitHub Copilot license. Local proxy translating Anthropic Messages API to GitHub Copilot's OpenAI API.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "proxy-claude": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsdown && node -e \"require('fs').copyFileSync('src/statusline.js','dist/statusline.js')\"",
    "start": "node dist/main.js",
    "dev": "node --watch --experimental-strip-types ./src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsdown": "^0.15.6",
    "typescript": "^5.9.3"
  }
}
